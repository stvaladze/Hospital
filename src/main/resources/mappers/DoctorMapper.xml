<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.solvd.hospital.dao.IDoctorDAO">

    <insert id="create">

        INSERT INTO doctors(first_name, last_name)
        VALUES (#{firstName}, #{lastName})

    </insert>

    <select id="getById"
            parameterType="int"
            resultType="com.solvd.hospital.model.Doctor">

        SELECT *
        FROM doctors
        WHERE id = #{id}

    </select>

    <select id="getAll"
            resultType="com.solvd.hospital.model.Doctor">

        SELECT *
        FROM doctors

    </select>

    <update id="update">

        UPDATE doctors
        SET first_name = #{firstName},
        last_name = #{lastName}
        WHERE id = #{id}

    </update>

    <delete id="delete">

        DELETE FROM doctors
        WHERE id = #{id}

    </delete>

</mapper>