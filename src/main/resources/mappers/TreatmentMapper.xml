<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="TreatmentMapper">

    <insert id="insert">

        INSERT INTO treatments(name)
        VALUES (#{name})

    </insert>

    <select id="selectById"
            parameterType="int"
            resultType="com.solvd.hospital.model.Treatment">

        SELECT *
        FROM treatments
        WHERE id = #{id}

    </select>

    <select id="selectAll"
            resultType="com.solvd.hospital.model.Treatment">

        SELECT *
        FROM treatments

    </select>

    <update id="update">

        UPDATE treatments
        SET name = #{name}
        WHERE id = #{id}

    </update>

    <delete id="delete">

        DELETE FROM treatments
        WHERE id = #{id}

    </delete>

</mapper>